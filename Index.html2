
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KalKaMain - AI Photo Studio</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,sans-serif;
 background:#100d20;
 color:white;
}
header{
 text-align:center;
 padding:25px 12px;
 background:linear-gradient(120deg,#31105e,#9b286f);
}
header h1{margin:0;font-size:32px}
header p{margin:8px 0 0;color:#f5d9ef}
.container{
 max-width:650px;
 margin:auto;
 padding:18px;
}
.card{
 background:#211b36;
 border:1px solid #51406b;
 border-radius:16px;
 padding:18px;
 margin-bottom:16px;
}
label{
 display:block;
 margin:14px 0 8px;
 font-weight:bold;
}
input,select,textarea{
 width:100%;
 padding:13px;
 border-radius:9px;
 border:1px solid #77638f;
 background:#171326;
 color:white;
 font-size:15px;
}
textarea{min-height:100px;resize:vertical}
button{
 width:100%;
 padding:15px;
 border:0;
 border-radius:10px;
 background:linear-gradient(90deg,#ff8a32,#ed3c91);
 color:white;
 font-size:17px;
 font-weight:bold;
 margin-top:15px;
}
button:disabled{opacity:.6}
.preview{
 width:100%;
 max-height:350px;
 object-fit:contain;
 margin-top:12px;
 border-radius:12px;
 display:none;
}
#resultImage{
 width:100%;
 border-radius:12px;
 margin-top:15px;
}
#result{display:none;text-align:center}
.small{font-size:13px;color:#c9bed9;line-height:1.5}
footer{text-align:center;padding:20px;color:#b9abc9}
</style>
</head>

<body>

<header>
<h1>✨ KalKaMain ✨</h1>
<p>Imagine Karo, AI Se Banwao!</p>
</header>

<div class="container">

<div class="card">
<h2>📸 Apni Photo Upload Karo</h2>

<label>Apni photo chunein</label>
<input type="file" id="photoInput" accept="image/*">

<img id="preview" class="preview" alt="Your uploaded photo">

<p class="small">Saaf aur achhi quality ki photo upload karein.</p>
</div>

<div class="card">
<h2>🎨 Apni Pasand Ka Design Chunein</h2>

<label>Photo ka style</label>
<select id="styleSelect">
<option value="Custom">Apni Marzi Ka Design</option>
<option value="Anime inspired storybook illustration">Anime Cartoon</option>
<option value="Cute high quality 3D cartoon portrait">3D Cartoon</option>
<option value="Royal luxury cinematic portrait">Royal Look</option>
<option value="Indian traditional wedding portrait">Wedding Look</option>
<option value="Beautiful birthday photoshoot">Birthday</option>
<option value="Diwali festive portrait with beautiful lights">Diwali</option>
<option value="Colorful Holi festival portrait">Holi</option>
<option value="Lohri festival bonfire portrait">Lohri</option>
<option value="Traditional Indian royal portrait">Traditional Indian</option>
<option value="Cinematic future self portrait">Future Self</option>
<option value="Professional model photoshoot">Model Photoshoot</option>
<option value="Fantasy magical portrait">Fantasy Look</option>
<option value="Custom collage design">Photo Collage</option>
</select>

<label>Apni pasand ka design khud likhein</label>
<textarea id="customPrompt"
placeholder="Jaise: Mujhe sher ke saath royal look chahiye, black suit, beautiful background..."></textarea>

<label>Kitni photo chahiye?</label>
<select id="collageCount">
<option value="1">1 Photo</option>
<option value="2">2 Photo</option>
<option value="4">4 Photo Collage</option>
<option value="6">6 Photo Collage</option>
<option value="9">9 Photo Collage</option>
<option value="12">12 Photo Collage</option>
<option value="16">16 Photo Collage</option>
<option value="20">20 Photo Collage</option>
<option value="24">24 Photo Collage</option>
</select>

<p class="small">
Aap apni pasand ka koi bhi design likh sakte hain.
AI ko aapke instructions ke hisaab se photo banani hogi.
</p>

<button id="generate">✨ Generate AI Photo</button>
</div>

<div class="card" id="result">
<h2>🎉 Aapki AI Photo</h2>
<p id="status">Aapki photo taiyar ho rahi hai...</p>
<img id="resultImage" alt="AI generated photo">
<a id="download" download="kalkamain-photo.png">
<button type="button">⬇ Download Photo</button>
</a>
</div>

</div>

<footer>
KalKaMain © 2026 | Your Imagination, Our AI
</footer>

<script>
const photoInput = document.getElementById('photoInput');
const preview = document.getElementById('preview');
const generate = document.getElementById('generate');
const result = document.getElementById('result');
const resultImage = document.getElementById('resultImage');
const download = document.getElementById('download');

let uploadedPhoto = '';

photoInput.addEventListener('change', () => {
 const file = photoInput.files[0];
 if (!file) return;

 if (!file.type.startsWith('image/')) {
  alert('Please select an image.');
  return;
 }

 const reader = new FileReader();
 reader.onload = () => {
  uploadedPhoto = reader.result;
  preview.src = uploadedPhoto;
  preview.style.display = 'block';
 };
 reader.readAsDataURL(file);
});

generate.addEventListener('click', async () => {
 if (!uploadedPhoto) {
  alert('Please upload your photo first.');
  return;
 }

 const style = document.getElementById('styleSelect').value;
 const custom = document.getElementById('customPrompt').value.trim();
 const count = document.getElementById('collageCount').value;

 const prompt = `
 Create an image based on the uploaded person's photograph.
 Selected design: ${style}.
 Customer's instructions: ${custom || 'Follow the selected design'}.
 Requested output: ${count} photo(s).
 Preserve the person's recognizable facial identity.
 Follow the customer's requested background, clothing and mood.
 Do not add unwanted text or watermarks.
 `;

 generate.disabled = true;
 generate.textContent = '⏳ AI Photo Bana Raha Hai...';
 result.style.display = 'block';
 resultImage.style.display = 'none';
 document.getElementById('status').textContent =
 'AI aapki photo bana raha hai. Kripya intezar karein.';

 try {
  const response = await fetch(
   'https://kalkamain-photo-ai.kshiv33093.workers.dev',
   {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
     image:uploadedPhoto,
     prompt:prompt,
     style:style,
     collageCount:Number(count)
    })
   }
  );

  const data = await response.json();

  if (!response.ok) {
   throw new Error(data.error || 'Photo generation failed');
  }

  const output = data.data && data.data[0];

  if (output && output.url) {
   resultImage.src = output.url;
  } else if (output && output.b64_json) {
   resultImage.src = 'data:image/png;base64,' + output.b64_json;
  } else {
   throw new Error('AI ne photo return nahi ki. Backend setup check karna hoga.');
  }

  resultImage.style.display = 'block';
  download.href = resultImage.src;
  document.getElementById('status').textContent = 'Aapki photo taiyar hai!';

 } catch(error) {
  document.getElementById('status').textContent =
   'Photo abhi nahi bani: ' + error.message;
 } finally {
  generate.disabled = false;
  generate.textContent = '✨ Generate AI Photo';
 }
});
</script>

</body>
</html>
